VITE_SUPABASE_URL=https://yzuxdrknidveptvnwthf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- parasut-sync Edge Function secrets --------------------------------
# These are server-side only. Never prefix them with VITE_ and never set
# them anywhere the frontend bundle can read them.
# Set on the hosted project with:
#   npx supabase secrets set --env-file .env.parasut-sync
# (keep that file out of git; this .env.example only documents the names.)
PARASUT_CLIENT_ID=placeholder-parasut-oauth-client-id
PARASUT_CLIENT_SECRET=placeholder-parasut-oauth-client-secret
PARASUT_USERNAME=placeholder-parasut-account-email
PARASUT_PASSWORD=placeholder-parasut-account-password
PARASUT_COMPANY_ID=placeholder-parasut-company-id
# Optional overrides; defaults match the official API.
PARASUT_BASE_URL=https://api.parasut.com
PARASUT_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
